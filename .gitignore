# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Raw PDFs exclusion
data/raw_pdfs/*.pdf
*.pdf

# Bulk generated output files
output/*.json
output/*.mmd
output/*.md
