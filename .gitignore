# Model checkpoints binaries
models/checkpoints/*.bin
models/checkpoints/*.pt
models/checkpoints/*.pth

# Environments
.env
.venv
env/
venv/
ENV/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Test / Coverage outputs
.coverage
htmlcov/
.pytest_cache/
